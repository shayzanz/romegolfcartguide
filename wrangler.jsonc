// Cloudflare Workers: serves the pre-built site in /site.
// worker/index.js runs first only to redirect www -> apex, then hands every request to the static assets.
{
  "name": "romegolfcartguide",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
